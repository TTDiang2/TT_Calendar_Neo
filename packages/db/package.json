{
  "name": "@tt-calendar/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle ORM + SQLite：与既有 calendar.db 逐列对齐的 schema、按实体分 store、版本化迁移",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate": "drizzle-kit migrate",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tt-calendar/contracts": "workspace:*",
    "@tt-calendar/domain": "workspace:*",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.3",
    "sql.js": "^1.14.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/sql.js": "^1.4.11",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
