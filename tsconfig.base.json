{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "forceConsistentCasingInFileNames": true,

    "composite": false,
    "declaration": false,
    "sourceMap": true,

    "baseUrl": ".",
    "paths": {
      "@tt-calendar/contracts": ["packages/contracts/src/index.ts"],
      "@tt-calendar/contracts/*": ["packages/contracts/src/*"],
      "@tt-calendar/domain": ["packages/domain/src/index.ts"],
      "@tt-calendar/domain/*": ["packages/domain/src/*"],
      "@tt-calendar/db": ["packages/db/src/index.ts"],
      "@tt-calendar/db/*": ["packages/db/src/*"],
      "@tt-calendar/ui": ["packages/ui/src/index.ts"],
      "@tt-calendar/ui/*": ["packages/ui/src/*"]
    }
  }
}
