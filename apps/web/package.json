{
  "name": "@tt-calendar/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web 模式：Vite SPA 开发预览，复用 packages/ui。数据走本机 Node 数据服务（apps/web/server.ts，读本地 SQLite），非浏览器持久化",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --import tsx server.ts",
    "dev:all": "concurrently -k -n data,web \"pnpm dev:server\" \"pnpm dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tt-calendar/contracts": "workspace:*",
    "@tt-calendar/db": "workspace:*",
    "@tt-calendar/domain": "workspace:*",
    "@tt-calendar/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
