# 无头环境（GitHub Actions CI / Mac 一键构建脚本）下的 pnpm 行为修正。
#
# 背景：pnpm 11 在 build 前会复检依赖(verify-deps-before-run)，进而想清理并重建
# node_modules；在非交互终端里它会询问是否清理，拿不到回答就直接中止：
#   ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY
# tauri 的 iOS "Build Rust Code" phase 内部会调 pnpm，于是整条 iOS 构建被打断。
#
# 设为 false 后：不再询问、直接清理；也不在 build 前复检依赖。
# 本地开发机同样安全（省掉一次询问与复核，行为不变）。
confirm-modules-purge=false
verify-deps-before-run=false
